# Copie este arquivo para .env e preencha com seus valores reais
# Para Render (PostgreSQL gerenciado): use DATABASE_URL fornecido automaticamente
# ao vincular o banco ao Web Service. Deixe comentado se usar DATABASE_URL.
# DATABASE_URL=postgresql://user:senha@host:5432/dbname?sslmode=require

# Fallback quando não houver DATABASE_URL (variáveis individuais):
DB_HOST=seu-postgres-host.exemplo.com
DB_PORT=5432
DB_NAME=art_portfolio
DB_USER=seu-usuario-postgres
DB_PASSWORD=sua-senha-postgres

ADMIN_USERNAME=admin
ADMIN_PASSWORD=sua-senha-forte
ADMIN_SESSION_TTL_HOURS=8
PORT=3000
IMAGE_SERVICE_URL=https://seu-image-service.exemplo.com
